{
  "$defs": {
    "DugConcept": {
      "description": "An ontological concept used to organise and link searchable elements.\n\nEach concept maps to at least one DugElement and carries identifiers (e.g.\nontology CURIEs) and knowledge-graph query results.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "concept",
          "default": "concept",
          "title": "Type",
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "identifiers": {
          "additionalProperties": true,
          "title": "Identifiers",
          "type": "object"
        },
        "kg_answers": {
          "additionalProperties": true,
          "title": "Kg Answers",
          "type": "object"
        },
        "concept_type": {
          "default": "",
          "title": "Concept Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugConcept",
      "type": "object"
    },
    "DugDocument": {
      "description": "A textual file attached to a study, such as a README, protocol, report or poster.\n\n`name` is the display title (the file name when no curated title is known), `description`\nis a summary of the document, and `action` is the URL to link out to. The document's text\nlives in its `DugDocumentSection` children rather than on the document itself, so that\nevery piece of text is searchable and annotatable in the same way.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "document",
          "default": "document",
          "title": "Type",
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "file_name": {
          "default": "",
          "description": "Original file name, e.g. 'README.pdf'.",
          "title": "File Name",
          "type": "string"
        },
        "mime_type": {
          "default": "",
          "description": "IANA media type, e.g. 'application/pdf'.",
          "title": "Mime Type",
          "type": "string"
        },
        "document_type": {
          "default": "",
          "description": "Kind of document; recommended values are listed in DOCUMENT_KINDS.",
          "title": "Document Type",
          "type": "string"
        },
        "authors": {
          "description": "Author names in citation order.",
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bare DOI of this document, without a resolver prefix.",
          "title": "Doi"
        },
        "license": {
          "default": "",
          "description": "SPDX licence identifier; empty when unknown.",
          "title": "License",
          "type": "string"
        },
        "can_display_content": {
          "default": false,
          "description": "True only when the licence permits showing section text in a user interface; otherwise the text may be indexed but users should be sent to `action`.",
          "title": "Can Display Content",
          "type": "boolean"
        },
        "section_list": {
          "description": "IDs of this document's DugDocumentSections, in reading order.",
          "items": {
            "type": "string"
          },
          "title": "Section List",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugDocument",
      "type": "object"
    },
    "DugDocumentSection": {
      "description": "A headed section of a `DugDocument`.\n\n`name` is the heading and `description` is the body text under it. `parents` holds the ID\nof the containing document, with `parent_type` set to 'document'.\n\n`can_display_content` should be copied from the parent document, so that a section can be\nshown or withheld without looking its document up.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "document_section",
          "default": "document_section",
