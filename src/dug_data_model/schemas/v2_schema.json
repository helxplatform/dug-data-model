            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "position": {
          "default": 0,
          "description": "0-based order of this section within its document.",
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading depth (1 = top level) when the source format exposes it.",
          "title": "Level"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page this section starts on, for paginated formats.",
          "title": "Page"
        },
        "can_display_content": {
          "default": false,
          "description": "Copy of the parent DugDocument's can_display_content. When False, the body text is indexed but left out of API responses.",
          "title": "Can Display Content",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugDocumentSection",
      "type": "object"
