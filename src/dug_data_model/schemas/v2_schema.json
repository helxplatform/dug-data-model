{
  "$defs": {
    "DugConcept": {
      "description": "An ontological concept used to organise and link searchable elements.\n\nEach concept maps to at least one DugElement and carries identifiers (e.g.\nontology CURIEs) and knowledge-graph query results.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "concept",
          "default": "concept",
          "title": "Type",
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "identifiers": {
          "additionalProperties": true,
          "title": "Identifiers",
          "type": "object"
        },
        "kg_answers": {
          "additionalProperties": true,
          "title": "Kg Answers",
          "type": "object"
        },
        "concept_type": {
          "default": "",
          "title": "Concept Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugConcept",
      "type": "object"
    },
    "DugContent": {
      "description": "A piece of a `DugDocument`'s text: a heading and the body under it.\n\nContent is the only element that holds a document's text. A `DugDocument` describes and\nlinks to a file; if the file's text can be read, it is split into DugContent children, one\nper heading (or a single one when there are no headings). `name` is the heading and\n`description` is the text. `parents` holds the ID of the containing document, with\n`parent_type` set to 'document'.\n\nBecause content is the only element with anything to display, it is also the only one\nthat carries `can_display_content`. Producers set it from the document's licence with\n`can_display()` (see `licenses.py`); the document itself does not repeat it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "content",
          "default": "content",
          "title": "Type",
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "position": {
          "default": 0,
          "description": "0-based order of this content within its document.",
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading depth (1 = top level) when the source format exposes it.",
          "title": "Level"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page this content starts on, for paginated formats.",
          "title": "Page"
        },
        "can_display_content": {
          "default": false,
          "description": "True only when the licence permits showing the text in a user interface; producers set it with can_display() from DISPLAYABLE_LICENSES. When False, the text is indexed but should not be shown, and users should be sent to `action` instead.",
          "title": "Can Display Content",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugContent",
      "type": "object"
    },
    "DugDocument": {
      "description": "A single file: a README, protocol, report, poster, ...\n\nA repository deposit is a `DugResource`; one file in it is a document. Like a resource, a\ndocument has a title (`name`), a summary (`description`), a landing or download URL\n(`action`), and the citation fields `repository`, `authors`, `doi` and `license`, which\nboth get from `DugCitable`; it adds what only a file has: `file_name`, `mime_type` and\n`document_type`. A document is not a resource: `isinstance(x, DugResource)` is false for\nit, so code that picks out deposits by class does not pick up their files too.\n\nA document holds no text of its own. Whatever could be read out of the file lives in its\n`DugContent` children (`content_list`), so that every piece of text is searchable and\nannotatable in the same way, and so that whether text may be shown is decided once, on the\ncontent that would be shown. A document whose text could not be read -- a scanned PDF, or\na file the curator named that no parser handles -- is still a document: it is listed and\nlinked to, with no content. Bulk data files (recordings, scans, spreadsheets of primary\ndata) are not documents; a producer inventories them on the resource they came from.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "document",
          "default": "document",
          "title": "Type",
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "title": "Programs",
          "type": "array"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "parent_type": {
          "default": "",
          "title": "Parent Type",
          "type": "string"
        },
        "concepts": {
          "additionalProperties": {
            "$ref": "#/$defs/DugConcept"
          },
          "title": "Concepts",
          "type": "object"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "optional_terms": {
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "tags": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tags",
          "type": "array"
        },
        "repository": {
          "default": "",
          "description": "Slug of the repository hosting this item; recommended values are listed in REPOSITORY_KINDS.",
          "title": "Repository",
          "type": "string"
        },
        "authors": {
          "description": "Author names in citation order.",
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi": {
          "default": "",
          "description": "Bare DOI of this item, without a resolver prefix; empty when unknown.",
          "title": "Doi",
          "type": "string"
        },
        "license": {
          "default": "",
          "description": "SPDX licence identifier; empty when unknown.",
          "title": "License",
          "type": "string"
        },
        "file_name": {
          "default": "",
          "description": "Original file name, e.g. 'README.pdf'.",
          "title": "File Name",
          "type": "string"
        },
        "mime_type": {
          "default": "",
          "description": "IANA media type, e.g. 'application/pdf'.",
          "title": "Mime Type",
          "type": "string"
        },
        "document_type": {
          "default": "",
          "description": "Kind of document; recommended values are listed in DOCUMENT_KINDS.",
          "title": "Document Type",
          "type": "string"
        },
        "content_list": {
          "description": "IDs of this document's DugContent, in reading order.",
          "items": {
            "type": "string"
          },
          "title": "Content List",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DugDocument",
      "type": "object"
    },
    "DugResource": {
      "description": "Something outside Dug that can be pointed to with a URL and a description.\n\nThe main use is the repository deposit that a study's files came from, e.g. a Figshare\narticle, a Zenodo or Dataverse dataset, or an OpenNeuro dataset. `name` is the deposit's\ntitle, `description` is its description, and `action` is its landing page. A resource\nwith a DOI is citable. A single file within a deposit is a `DugDocument`, which shares the\ncitation fields (`repository`, `authors`, `doi`, `license`) through `DugCitable` but is not\na resource.",
      "properties": {
        "id": {
